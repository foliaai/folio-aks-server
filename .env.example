# ==================== 数据库认证信息 ====================
# 所有 IP/主机相关配置一律由环境变量提供，config.toml 不再承载任何主机字段。
# 开发环境用 localhost / 本机端口；生产环境用 Docker 容器名（同网络内解析）。
# 数据 namespace 也由 env 提供：dev 用 dev_*，prod 用 default，互不污染。

# Milvus 认证（dev: localhost / prod: milvus-standalone）
MILVUS_HOST=
MILVUS_DATABASE=
MILVUS_USER=root
MILVUS_PASSWORD=your_milvus_password
# Milvus token（如果使用token认证）
MILVUS_TOKEN=

# MongoDB 认证（dev: localhost / prod: mongodb）
MONGODB_HOST=
MONGODB_DATABASE=
MONGODB_USER=admin
MONGODB_PASSWORD=your_mongodb_password
# MongoDB 认证数据库
MONGODB_AUTH_SOURCE=admin
# MongoDB 连接字符串（可选，如果提供则优先使用）
MONGODB_URI=

# MySQL 认证（dev: localhost / prod: services_mysql）
MYSQL_HOST=
MYSQL_DATABASE=
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# Neo4j 认证（dev: bolt://localhost:7687 / prod: bolt://neo4j:7687）
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Redis 认证（dev: localhost / prod: services_redis）
REDIS_HOST=
REDIS_PASSWORD=your_redis_password
# Redis db 编号（dev: 3 / prod: 2；dev/prod 在同一 Redis 实例上按 db 隔离）
REDIS_DB=
# Redis 用户名（Redis 6.0+支持）
REDIS_USERNAME=

# MinIO 认证（dev: localhost:9000 / prod: milvus-minio:9000）
# 桶名不允许下划线，dev 用 dev-default
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_minio_secret_key

# ==================== Kafka 消息队列 ====================

# Kafka 集群地址（逗号分隔；dev: localhost:9092 / prod: kafka:9092）
KAFKA_BOOTSTRAP_SERVERS=
# Kafka 消费组前缀（dev: aks_dev / prod: aks）
KAFKA_GROUP_ID_PREFIX=
# Kafka Topic 名称前缀（dev: dev_ / prod: 留空；用于 dev/prod 在同一集群上的 topic 级隔离）
KAFKA_TOPIC_PREFIX=
# Kafka 认证（如果使用SASL认证）
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Kafka SSL证书路径（如果使用SSL）
KAFKA_SSL_CAFILE=
KAFKA_SSL_CERTFILE=
KAFKA_SSL_KEYFILE=
KAFKA_SSL_PASSWORD=

# ==================== 模型网关 ====================
# 大模型网关类型（model_lake / litellm），未设时默认 litellm
# model_lake = ModelNexus 网关（OpenAI 兼容协议，静态 mn-sk- Key，无需换票）
# Embedding / Reranker 统一走 LiteLLM Proxy
MODEL_GATEWAY_TYPE=
MODEL_GATEWAY_TIMEOUT=60
MODEL_GATEWAY_MAX_RETRIES=2

# ModelNexus 网关（OpenAI 兼容；BASE 必须配到 /v1 结尾的完整地址，原样使用）
# 端点形如 https://modelnexus.example.com:20443/model-nexus/api/v1
MODEL_LAKE_BASE=
MODEL_LAKE_API_KEY=

# LiteLLM Proxy（Embedding / Reranker 默认网关；也是未配置 ModelNexus 时的 LLM 回落）
LITELLM_PROXY_URL=
LITELLM_PROXY_KEY=

# ==================== 本地直连 API Keys（未走模型网关的服务） ====================

# 稀疏向量 Embedding（BGE-M3，本地部署，未走模型网关，可选）
# API 地址（dev: http://localhost:18085/v1 / prod: http://bge-m3-server:18085/v1）
SPARSE_EMBEDDING_API_BASE=
SPARSE_EMBEDDING_API_KEY=

# ==================== 第三方服务 ====================

# MinerU 服务（PDF 解析）
# API 地址（如 http://192.168.19.232:18000）
MINERU_API_URL=
MINERU_API_KEY=

# LibreOffice（Word/PPT → PDF）
# soffice 可执行文件路径：
#   macOS: /Applications/LibreOffice.app/Contents/MacOS/soffice
#   Linux/Docker: 留空用默认 "soffice"（装 libreoffice 后在 PATH 中），或填 /usr/bin/soffice
LIBREOFFICE_SOFFICE_PATH=
# 转换超时（秒）；毕业论文等大文档建议 300~600
LIBREOFFICE_CONVERT_TIMEOUT=600

# ==================== 系统配置 ====================

# 应用环境: development, production, testing
APP_ENV=development

# 调试模式
DEBUG=true

# 日志级别（覆盖默认：dev=DEBUG / prod=INFO；留空则按 APP_ENV 自动选择）
LOG_LEVEL=DEBUG

# CORS 允许的前端来源（逗号分隔；开发环境留空默认允许本地，生产环境如 https://www.hijarson.com）
CORS_ALLOWED_ORIGINS=

# ==================== 统一认证（folio-auth-server） ====================
# 登录/签发由 folio-auth-server 承担（上游 Logto 或企业 OA，随部署环境而定），
# AKS 只验它签发的 RS256 JWT（Bearer / query token / WebSocket），无兼容层。

# folio-auth-server 根地址（dev: http://localhost:8003 / prod: http://folio-auth-api:8003）
AUTH_SERVER_URL=http://localhost:8003

# 应用密钥（用于加密等）
APP_SECRET_KEY=your_secret_key_change_in_production

# 自动建表（Milvus 是否自动建 collection）
MILVUS_AUTO_CREATE_COLLECTION=true

# skill-service 地址（dev: http://localhost:8001 / prod: http://skill-service:8001）
SKILL_SERVICE_URL=http://localhost:8001
